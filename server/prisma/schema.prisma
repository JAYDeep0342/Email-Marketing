  subStatus String?                @map("sub_status")
  createdAt DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  job    VerificationJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("verification_results")
}

// ============================================================
//  I. TRACKING & ANALYTICS
//  NOTE: `events` is a PARTITIONED table (by occurred_at, monthly).
//  Prisma can't declare partitioning. We define the model for type-safe
//  Client access, but in Step 4C raw SQL we DROP Prisma's plain table and
//  recreate it as PARTITION BY RANGE, add partitions + DEFAULT + log views.
//  Composite PK (id, occurred_at) is required by Postgres for partitioning.
// ============================================================

model Event {
  id         String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  campaignId String?   @map("campaign_id") @db.Uuid
  contactId  String?   @map("contact_id") @db.Uuid
  emailJobId String?   @map("email_job_id") @db.Uuid
  // `type` is TEXT + CHECK constraint in the DB, NOT a Postgres enum.
  // `events` is partitioned and 6 log views (delivery_log, open_log, click_log,
  // bounce_log, feedback_log, unsubscribe_log) read this column, so ALTER TYPE
  // fails. Keeping it String here is what stops the repeated migrate drift.
  // Allowed values are enforced by events_type_check — see 20260805102202.
  type       String    @db.Text
  url        String?
  userAgent  String?   @map("user_agent")
  ipAddress  String?   @map("ip_address") @db.Inet
  meta       Json      @default("{}")
  occurredAt DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)

  @@id([id, occurredAt])
  @@index([tenantId, campaignId])
  @@index([type, occurredAt])
  @@map("events")
}

model CampaignStat {
  campaignId       String   @id @map("campaign_id") @db.Uuid
  tenantId         String   @map("tenant_id") @db.Uuid
  totalRecipients  Int      @default(0) @map("total_recipients")
  sentCount        Int      @default(0) @map("sent_count")
  deliveredCount   Int      @default(0) @map("delivered_count")
  openCount        Int      @default(0) @map("open_count")
  uniqueOpenCount  Int      @default(0) @map("unique_open_count")
  clickCount       Int      @default(0) @map("click_count")
  bounceCount      Int      @default(0) @map("bounce_count")
  complaintCount   Int      @default(0) @map("complaint_count")
  unsubscribeCount Int      @default(0) @map("unsubscribe_count")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("campaign_stats")
}

// ============================================================
//  J. AI FEATURES
// ============================================================

model AiGeneration {
  id          String             @id @default(uuid()) @db.Uuid
  tenantId    String             @map("tenant_id") @db.Uuid
  userId      String?            @map("user_id") @db.Uuid
  feature     String
  provider    String             @default("anthropic")
  model       String?
  prompt      String
  output      String?
  tokensUsed  Int?               @map("tokens_used")
  creditsCost BigInt             @default(0) @map("credits_cost")
  status      AiGenerationStatus @default(completed)
  createdAt   DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  subjectSuggestions   AiSubjectSuggestion[]
  conversationMessages AiConversationMessage[]
  feedback             AiFeedback[]

  @@index([tenantId, createdAt])
  @@map("ai_generations")
}

model AiCredit {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  credits    BigInt
  priceCents Int      @map("price_cents")
  currencyId String?  @map("currency_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ai_credits")
}

model AiSubjectSuggestion {
  id                String   @id @default(uuid()) @db.Uuid
  tenantId          String   @map("tenant_id") @db.Uuid
  campaignId        String?  @map("campaign_id") @db.Uuid
  generationId      String?  @map("generation_id") @db.Uuid
  suggestion        String
  predictedOpenRate Decimal? @map("predicted_open_rate") @db.Decimal(5, 2)
  wasSelected       Boolean  @default(false) @map("was_selected")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  generation AiGeneration? @relation(fields: [generationId], references: [id])

  @@index([campaignId])
  @@map("ai_subject_suggestions")
}

model AiConversation {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String               @map("tenant_id") @db.Uuid
  userId    String?              @map("user_id") @db.Uuid
  title     String?
  context   String?
  status    AiConversationStatus @default(active)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  messages AiConversationMessage[]

  @@index([tenantId, createdAt])
  @@map("ai_conversations")
}

model AiConversationMessage {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String        @map("conversation_id") @db.Uuid
  generationId   String?       @map("generation_id") @db.Uuid
  role           AiMessageRole
  content        String
  tokensUsed     Int?          @map("tokens_used")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  generation   AiGeneration?  @relation(fields: [generationId], references: [id])

  feedback AiFeedback[]

  @@index([conversationId, createdAt])
  @@map("ai_conversation_messages")
}

model AiFeedback {
  id           String           @id @default(uuid()) @db.Uuid
  tenantId     String           @map("tenant_id") @db.Uuid
  userId       String?          @map("user_id") @db.Uuid
  generationId String?          @map("generation_id") @db.Uuid
  messageId    String?          @map("message_id") @db.Uuid
  rating       AiFeedbackRating
  reason       String?
  comment      String?
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant     Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  generation AiGeneration?          @relation(fields: [generationId], references: [id], onDelete: Cascade)
  message    AiConversationMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([generationId])
  @@map("ai_feedback")
}

model AiSelfImproveRun {
  id           String              @id @default(uuid()) @db.Uuid
  name         String
  runType      AiSelfImproveType   @map("run_type")
  status       AiSelfImproveStatus @default(pending)
  feedbackFrom DateTime?           @map("feedback_from") @db.Timestamptz(6)
  feedbackTo   DateTime?           @map("feedback_to") @db.Timestamptz(6)
  metrics      Json                @default("{}")
  notes        String?
  startedAt    DateTime?           @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime?           @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("ai_self_improve_runs")
}

// ============================================================
//  K. INTEGRATIONS
// ============================================================

model Integration {
  id           String  @id @default(uuid()) @db.Uuid
  slug         String  @unique
  name         String
  category     String?
  configSchema Json    @default("{}") @map("config_schema")
  isActive     Boolean @default(true) @map("is_active")

  connections IntegrationConnection[]

  @@map("integrations")
}

model IntegrationConnection {
  id                   String                      @id @default(uuid()) @db.Uuid
  tenantId             String                      @map("tenant_id") @db.Uuid
  integrationId        String                      @map("integration_id") @db.Uuid
  name                 String?
  encryptedCredentials String?                     @map("encrypted_credentials")
  settings             Json                        @default("{}")
  status               IntegrationConnectionStatus @default(connected)
  lastSyncedAt         DateTime?                   @map("last_synced_at") @db.Timestamptz(6)
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  integration Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([integrationId])
  @@map("integration_connections")
}

// ============================================================
//  L. SYSTEM & COMMUNICATIONS
// ============================================================

model Notification {
  id        String               @id @default(uuid()) @db.Uuid
  tenantId  String?              @map("tenant_id") @db.Uuid
  userId    String?              @map("user_id") @db.Uuid
  type      String
  title     String
  body      String?
  data      Json                 @default("{}")
  channel   NotificationChannel  @default(in_app)
  priority  NotificationPriority @default(normal)
  readAt    DateTime?            @map("read_at") @db.Timestamptz(6)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("notifications")
}

model Webhook {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  url       String
  events    String[]
  secret    String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String                @id @default(uuid()) @db.Uuid
  tenantId     String?               @map("tenant_id") @db.Uuid
  webhookId    String                @map("webhook_id") @db.Uuid
  eventType    String                @map("event_type")
  payload      Json
  responseCode Int?                  @map("response_code")
  attempts     Int                   @default(0)
  status       WebhookDeliveryStatus @default(pending)
  createdAt    DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  deliveredAt  DateTime?             @map("delivered_at") @db.Timestamptz(6)

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([webhookId])
  @@map("webhook_deliveries")
}

model CustomPage {
  id        String         @id @default(uuid()) @db.Uuid
  tenantId  String?        @map("tenant_id") @db.Uuid
  slug      String
  type      CustomPageType
  subject   String?
  html      String
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, slug, type])
  @@map("custom_pages")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  adminId    String?  @map("admin_id") @db.Uuid
  action     String
  entityType String?  @map("entity_type")
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json     @default("{}")
  ipAddress  String?  @map("ip_address") @db.Inet
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  admin  PlatformAdmin? @relation(fields: [adminId], references: [id])

  @@index([tenantId, createdAt])
  @@map("audit_logs")
}

model RateLimit {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String?  @map("tenant_id") @db.Uuid
  scope      String
  limitCount Int      @map("limit_count")
  windowSecs Int      @map("window_secs")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, scope])
  @@map("rate_limits")
}
