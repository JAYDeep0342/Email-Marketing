generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
//  ENUMS (shared across models)
//  Prisma enums map to Postgres. We keep CHECK-style values here.
// ============================================================

enum PlanBillingPeriod {
  monthly
  yearly
}

enum AdminStatus {
  active
  disabled
}

// ============================================================
//  P1. PLATFORM PRIMITIVES
// ============================================================

model Currency {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  symbol       String
  name         String
  exchangeRate Decimal  @default(1) @map("exchange_rate") @db.Decimal(12, 6)
  isBase       Boolean  @default(false) @map("is_base")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  plans                  Plan[]
  sendingCreditPlans     SendingCreditPlan[]
  emailVerificationPlans EmailVerificationPlan[]
  invoices               Invoice[]
  paymentTransactions    PaymentTransaction[]
  coupons                Coupon[]
  orders                 Order[]

  @@map("currencies")
}

model Plan {
  id            String            @id @default(uuid()) @db.Uuid
  name          String
  code          String            @unique
  priceCents    Int               @default(0) @map("price_cents")
  currencyId    String?           @map("currency_id") @db.Uuid
  billingPeriod PlanBillingPeriod @default(monthly) @map("billing_period")
  planType      String            @default("general") @map("plan_type")
  isActive      Boolean           @default(true) @map("is_active")
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  currency      Currency?      @relation(fields: [currencyId], references: [id])
  planLimit     PlanLimit?
  tenants       Tenant[]
  subscriptions Subscription[]

  @@index([currencyId])
  @@map("plans")
}

model PlanLimit {
  id             String  @id @default(uuid()) @db.Uuid
  planId         String  @unique @map("plan_id") @db.Uuid
  maxContacts    Int?    @map("max_contacts")
  maxLists       Int?    @map("max_lists")
  maxEmailsMonth Int?    @map("max_emails_month")
  maxEmailsDay   Int?    @map("max_emails_day")
  maxSubscribers Int?    @map("max_subscribers")
  maxUsers       Int?    @map("max_users")
  maxCampaigns   Int?    @map("max_campaigns")
  maxAutomations Int?    @map("max_automations")
  dedicatedIp    Boolean @default(false) @map("dedicated_ip")
  aiEnabled      Boolean @default(false) @map("ai_enabled")

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("plan_limits")
}

model PlatformAdmin {
  id           String      @id @default(uuid()) @db.Uuid
  email        String      @unique
  passwordHash String      @map("password_hash")
  firstName    String?     @map("first_name")
  lastName     String?     @map("last_name")
  isSuper      Boolean     @default(false) @map("is_super")
  status       AdminStatus @default(active)
  lastLoginAt  DateTime?   @map("last_login_at") @db.Timestamptz(6)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  groupMemberships AdminGroupMember[]
  sessions         UserSession[]
  auditLogs        AuditLog[]

  @@map("platform_admins")
}

model AdminGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  permissions Json     @default("[]")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  members AdminGroupMember[]

  @@map("admin_groups")
}

model AdminGroupMember {
  adminId String @map("admin_id") @db.Uuid
  groupId String @map("group_id") @db.Uuid

  admin PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  group AdminGroup    @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([adminId, groupId])
  @@map("admin_group_members")
}

model PlatformSetting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json     @default("{}")
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("platform_settings")
}

model TaxSetting {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  ratePct   Decimal  @map("rate_pct") @db.Decimal(5, 2)
  country   String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("tax_settings")
}

model PaymentGateway {
  id                   String   @id @default(uuid()) @db.Uuid
  provider             String
  displayName          String   @map("display_name")
  encryptedCredentials String   @map("encrypted_credentials")
  isActive             Boolean  @default(true) @map("is_active")
  isDefault            Boolean  @default(false) @map("is_default")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  paymentTransactions PaymentTransaction[]

  @@map("payment_gateways")
}

model Language {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique
  name      String
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  @@map("languages")
}

model Plugin {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  slug        String   @unique
  version     String?
  config      Json     @default("{}")
  isEnabled   Boolean  @default(false) @map("is_enabled")
  installedAt DateTime @default(now()) @map("installed_at") @db.Timestamptz(6)

  @@map("plugins")
}

// ============================================================
//  ENUMS — Tenancy & Users
// ============================================================

enum TenantStatus {
  active
  suspended
  cancelled
}

enum UserStatus {
  active
  invited
  disabled
}

// ============================================================
//  A. TENANCY & USERS
// ============================================================

model Tenant {
  id         String       @id @default(uuid()) @db.Uuid
  name       String
  slug       String       @unique
  planId     String?      @map("plan_id") @db.Uuid
  status     TenantStatus @default(active)
  bounceRate Decimal      @default(0) @map("bounce_rate") @db.Decimal(5, 2)
  whiteLabel Json         @default("{}") @map("white_label")
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  plan Plan? @relation(fields: [planId], references: [id])

  users                  User[]
  roles                  Role[]
  apiKeys                ApiKey[]
  subscriptions          Subscription[]
  invoices               Invoice[]
  paymentTransactions    PaymentTransaction[]
  orders                 Order[]
  couponRedemptions      CouponRedemption[]
  usageRecords           UsageRecord[]
  creditWallet           CreditWallet?
  creditLedger           CreditLedger[]
  contacts               Contact[]
  lists                  List[]
  tags                   Tag[]
  segments               Segment[]
  suppressions           Suppression[]
  blacklist              Blacklist[]
  templateCategories     TemplateCategory[]
  templates              Template[]
  formTemplates          FormTemplate[]
  signatures             Signature[]
  campaigns              Campaign[]
  campaignRecipients     CampaignRecipient[]
  forms                  Form[]
  formSubmissions        FormSubmission[]
  automations            Automation[]
  automationSteps        AutomationStep[]
  automationRuns         AutomationRun[]
  sendingDomains         SendingDomain[]
  emailJobs              EmailJob[]
  unsubscribeTokens      UnsubscribeToken[]
  verificationJobs       VerificationJob[]
  verificationResults    VerificationResult[]
  campaignStats          CampaignStat[]
  aiGenerations          AiGeneration[]
  aiSubjectSuggestions   AiSubjectSuggestion[]
  aiConversations        AiConversation[]
  aiFeedback             AiFeedback[]
  integrationConnections IntegrationConnection[]
  notifications          Notification[]
  webhooks               Webhook[]
  customPages            CustomPage[]
  auditLogs              AuditLog[]
  rateLimits             RateLimit[]

  @@index([planId])
  @@map("tenants")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  email           String     @unique
  passwordHash    String     @map("password_hash")
  firstName       String?    @map("first_name")
  lastName        String?    @map("last_name")
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(6)
  mfaEnabled      Boolean    @default(false) @map("mfa_enabled")
  mfaSecret       String?    @map("mfa_secret")
  status          UserStatus @default(active)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  userRoles               UserRole[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sessions                UserSession[]

  @@index([tenantId])
  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String?  @map("tenant_id") @db.Uuid
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([tenantId, name])
  @@index([tenantId])
  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  key         String  @unique
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model ApiKey {
  id         String    @id @default(uuid()) @db.Uuid
  tenantId   String    @map("tenant_id") @db.Uuid
  name       String
  keyHash    String    @map("key_hash")
  keyPrefix  String    @map("key_prefix")
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("api_keys")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  ipAddress        String?   @map("ip_address") @db.Inet
  userAgent        String?   @map("user_agent")
  impersonatedBy   String?   @map("impersonated_by") @db.Uuid
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonator PlatformAdmin? @relation(fields: [impersonatedBy], references: [id])

  @@index([userId])
  @@map("user_sessions")
}

// ============================================================
//  ENUMS — Billing
// ============================================================

enum VerificationPayType {
  recurring
  one_time
}

enum SubscriptionProvider {
  stripe
  razorpay
  paypal
  manual
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  cancelled
  unpaid
  ended
  pending
}

enum InvoiceStatus {
  draft
  open
  paid
  void
  uncollectible
}

enum PaymentTxnType {
  charge
  refund
  chargeback
}

enum PaymentTxnStatus {
  pending
  succeeded
  failed
}

enum CreditType {
  sending
  verification
  ai
}

enum OrderStatus {
  pending
  paid
  failed
  refunded
  cancelled
}

enum OrderItemType {
  plan
  sending_credits
  verification_credits
  ai_credits
}

enum CouponDiscountType {
  percent
  fixed
}

enum CouponAppliesTo {
  all
  plan
  credits
  verification
}

// ============================================================
//  B. PLANS & BILLING
// ============================================================

model SendingCreditPlan {
  id         String   @id @default(uuid()) @db.Uuid
  name       String
  credits    BigInt
  priceCents Int      @map("price_cents")
  currencyId String?  @map("currency_id") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  currency Currency? @relation(fields: [currencyId], references: [id])

  @@map("sending_credit_plans")
}

model EmailVerificationPlan {
  id         String              @id @default(uuid()) @db.Uuid
  name       String
  payType    VerificationPayType @map("pay_type")
  credits    BigInt
  priceCents Int                 @map("price_cents")
  currencyId String?             @map("currency_id") @db.Uuid
  isActive   Boolean             @default(true) @map("is_active")
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  currency Currency? @relation(fields: [currencyId], references: [id])

  @@map("email_verification_plans")
}

model Subscription {
  id                 String                @id @default(uuid()) @db.Uuid
  tenantId           String                @map("tenant_id") @db.Uuid
  planId             String                @map("plan_id") @db.Uuid
  provider           SubscriptionProvider?
  providerSubId      String?               @map("provider_sub_id")
  status             SubscriptionStatus
  creditsRemaining   BigInt                @default(0) @map("credits_remaining")
  isRecurring        Boolean               @default(true) @map("is_recurring")
  currentPeriodStart DateTime?             @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime?             @map("current_period_end") @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean               @default(false) @map("cancel_at_period_end")
  subscribedAt       DateTime              @default(now()) @map("subscribed_at") @db.Timestamptz(6)
  endedAt            DateTime?             @map("ended_at") @db.Timestamptz(6)
  createdAt          DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  plan     Plan      @relation(fields: [planId], references: [id])
  invoices Invoice[]

  @@index([tenantId])
  @@index([planId])
  @@map("subscriptions")
}

model InvoiceTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  html      String
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("invoice_templates")
}

model Invoice {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  subscriptionId String?       @map("subscription_id") @db.Uuid
  invoiceNumber  String        @unique @map("invoice_number")
  reason         String?
  amountCents    Int           @map("amount_cents")
  taxCents       Int           @default(0) @map("tax_cents")
  currencyId     String?       @map("currency_id") @db.Uuid
  status         InvoiceStatus
  dueAt          DateTime?     @map("due_at") @db.Timestamptz(6)
  paidAt         DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  currency     Currency?     @relation(fields: [currencyId], references: [id])

  paymentTransactions PaymentTransaction[]
  orders              Order[]

  @@index([tenantId])
  @@index([subscriptionId])
  @@map("invoices")
}

model PaymentTransaction {
  id            String           @id @default(uuid()) @db.Uuid
  tenantId      String           @map("tenant_id") @db.Uuid
  invoiceId     String?          @map("invoice_id") @db.Uuid
  gatewayId     String?          @map("gateway_id") @db.Uuid
  providerTxnId String?          @map("provider_txn_id")
  type          PaymentTxnType
  amountCents   Int              @map("amount_cents")
  currencyId    String?          @map("currency_id") @db.Uuid
  status        PaymentTxnStatus
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice  Invoice?        @relation(fields: [invoiceId], references: [id])
  gateway  PaymentGateway? @relation(fields: [gatewayId], references: [id])
  currency Currency?       @relation(fields: [currencyId], references: [id])

  @@index([tenantId])
  @@index([invoiceId])
  @@map("payment_transactions")
}

model Coupon {
  id             String             @id @default(uuid()) @db.Uuid
  code           String             @unique
  description    String?
  discountType   CouponDiscountType @map("discount_type")
  discountValue  Decimal            @map("discount_value") @db.Decimal(12, 2)
  currencyId     String?            @map("currency_id") @db.Uuid
  maxRedemptions Int?               @map("max_redemptions")
  redeemedCount  Int                @default(0) @map("redeemed_count")
  perTenantLimit Int                @default(1) @map("per_tenant_limit")
  appliesTo      CouponAppliesTo    @default(all) @map("applies_to")
  startsAt       DateTime?          @map("starts_at") @db.Timestamptz(6)
  expiresAt      DateTime?          @map("expires_at") @db.Timestamptz(6)
  isActive       Boolean            @default(true) @map("is_active")
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  currency    Currency?          @relation(fields: [currencyId], references: [id])
  orders      Order[]
  redemptions CouponRedemption[]

  @@map("coupons")
}

model Order {
  id            String      @id @default(uuid()) @db.Uuid
  tenantId      String      @map("tenant_id") @db.Uuid
  orderNumber   String      @unique @map("order_number")
  invoiceId     String?     @map("invoice_id") @db.Uuid
  couponId      String?     @map("coupon_id") @db.Uuid
  currencyId    String?     @map("currency_id") @db.Uuid
  subtotalCents Int         @default(0) @map("subtotal_cents")
  discountCents Int         @default(0) @map("discount_cents")
  taxCents      Int         @default(0) @map("tax_cents")
  totalCents    Int         @default(0) @map("total_cents")
  status        OrderStatus @default(pending)
  placedAt      DateTime    @default(now()) @map("placed_at") @db.Timestamptz(6)
  paidAt        DateTime?   @map("paid_at") @db.Timestamptz(6)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invoice  Invoice?  @relation(fields: [invoiceId], references: [id])
  coupon   Coupon?   @relation(fields: [couponId], references: [id])
  currency Currency? @relation(fields: [currencyId], references: [id])

  items       OrderItem[]
  redemptions CouponRedemption[]

  @@index([tenantId])
  @@index([invoiceId])
  @@index([couponId])
  @@map("orders")
}

model OrderItem {
  id          String        @id @default(uuid()) @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  itemType    OrderItemType @map("item_type")
  itemRefId   String?       @map("item_ref_id") @db.Uuid
  description String
  quantity    Int           @default(1)
  unitCents   Int           @map("unit_cents")
  amountCents Int           @map("amount_cents")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_items")
}

model CouponRedemption {
  id            String   @id @default(uuid()) @db.Uuid
  couponId      String   @map("coupon_id") @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  orderId       String?  @map("order_id") @db.Uuid
  discountCents Int      @map("discount_cents")
  redeemedAt    DateTime @default(now()) @map("redeemed_at") @db.Timestamptz(6)

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order? @relation(fields: [orderId], references: [id])

  @@index([couponId])
  @@index([tenantId])
  @@map("coupon_redemptions")
}

model UsageRecord {
  id          String   @id @default(uuid()) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  metric      String
  periodStart DateTime @map("period_start") @db.Date
  quantity    BigInt   @default(0)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, metric, periodStart])
  @@index([tenantId, metric])
  @@map("usage_records")
}

model CreditWallet {
  id                  String   @id @default(uuid()) @db.Uuid
  tenantId            String   @unique @map("tenant_id") @db.Uuid
  sendingCredits      BigInt   @default(0) @map("sending_credits")
  verificationCredits BigInt   @default(0) @map("verification_credits")
  aiCredits           BigInt   @default(0) @map("ai_credits")
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

